# InvestLens 环境变量示例 —— 复制为 .env.local 后填写（.env.local 已在 .gitignore 中，切勿提交）
# 所有密钥只在服务端读取；不要给任何密钥加 NEXT_PUBLIC_ 前缀。

# ---------- 金融数据 ----------
# auto（默认）：配置了 FUYAO_API_KEY 则使用扶摇真实行情，否则使用合成演示数据（UI 明确标注）
# fuyao：强制使用扶摇；未配置 Key 时页面显示「未配置」，不会回退演示数据
# demo：强制使用合成演示数据
MARKET_DATA_PROVIDER=auto
# 同花顺扶摇金融数据 API Key（https://fuyao.aicubes.cn/docs/quickstart/ 登录后在「API Key 管理」签发）
FUYAO_API_KEY=
# 可选（实测快照通常 0.4 秒但偶有 4–10 秒以上长尾；日线 2–12 秒）
# FUYAO_BASE_URL=https://fuyao.aicubes.cn
# FUYAO_TIMEOUT_MS=6000          首次请求超时
# FUYAO_RETRY_TIMEOUT_MS=15000   超时后重试一次的超时
# FUYAO_HISTORY_TIMEOUT_MS=30000 历史日线单次超时
# 中转（可选）：部分云函数出口 IP 无法连接扶摇时，经 Cloudflare Worker 中转（代码见 relay/fuyao-worker）。
#   FUYAO_BASE_URL=https://investlens-fuyao-relay.<子域>.workers.dev
#   FUYAO_RELAY_SECRET=<至少 32 位随机串，与 Worker 的 RELAY_SECRET 相同；只在指向中转时发送，不会发给扶摇>
# FUYAO_RELAY_SECRET=

# ---------- 大模型（OpenAI Chat Completions 兼容协议） ----------
# 任意兼容服务商均可，例如：https://api.openai.com/v1 、https://api.deepseek.com/v1 、
# https://dashscope.aliyuncs.com/compatible-mode/v1 等（以服务商文档为准）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 合并进请求体的服务商扩展参数（JSON，可选）。DeepSeek 基准测试后的推荐配置（见 docs/ITERATION_3_REPORT.md）：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# LLM_EXTRA_BODY=
# 规划阶段可选的独立模型与参数（默认与上面相同）
# LLM_PLANNER_MODEL=
# LLM_PLANNER_EXTRA_BODY=
# 推理模型会先消耗推理 token，建议调大
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=120000
# 流式响应（用于真实进度显示），默认开启
# LLM_STREAM=on
# 服务商不支持 response_format=json_object 时可设为 off（系统也会自动降级一次）
# LLM_JSON_MODE=on

# ---------- 公网限流计数（Upstash Redis，可选但公网部署强烈建议） ----------
# 在 Vercel 项目 Storage 中添加 Upstash Redis 后会自动注入以下变量（两种命名都支持，任选其一）。
# 未配置时退回进程内存计数：只在单个实例内生效，多实例部署下限流较弱。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# 本机自动化测试可关闭限流；在 Vercel 上（VERCEL=1）此开关被忽略
# INVESTLENS_RATE_LIMIT=off

# ---------- 其它 ----------
# 关闭服务端结构化日志（日志本身不含密钥与画像）
# INVESTLENS_LOG=off
