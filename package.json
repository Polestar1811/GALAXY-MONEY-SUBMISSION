{
  "name": "investlens",
  "version": "0.1.0",
  "private": true,
  "description": "InvestLens — 先理解你，再理解市场。AI Native 个人投资研究伙伴（第一迭代：设计系统 + 个性化前端体验）",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "verify:live": "vitest run --config vitest.live.config.ts verify.live",
    "bench:models": "vitest run --config vitest.live.config.ts models.bench",
    "validate:product": "vitest run --config vitest.live.config.ts validation.live",
    "verify:live-ui": "playwright test --config playwright.live.config.ts real-research",
    "verify:v2": "vitest run --config vitest.live.config.ts v2.live",
    "verify:public": "playwright test --config playwright.live.config.ts real-research && playwright test --config playwright.live.config.ts public-acceptance",
    "record:demo": "playwright test --config playwright.live.config.ts demo-video"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-is": "19.2.9",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "react-is": "19.2.9"
  }
}
